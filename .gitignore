# ===== Gradle / Android 构建产物 =====
.gradle/
build/
captures/

# ===== 本机配置（含 SDK 路径，绝不能提交）=====
local.properties

# ===== IDE =====
.idea/
*.iml
*.ipr
*.iws

# ===== 操作系统 =====
.DS_Store
Thumbs.db
$RECYCLE.BIN/

# ===== 原生 / 外部构建 =====
.externalNativeBuild/
.cxx/
*.so

# ===== 日志与转储 =====
*.log
*.hprof

# ===== CodeBuddy 本地助手数据（非项目源码）=====
.codebuddy/

# ===== 项目根目录的垃圾文件 =====
# 构建/崩溃/widget 日志、堆转储、截图、异常文件
/*.txt
/*.png
/*.jpg
/$null

# UI Automator 层级转储（调试产物）
/ui.xml

# release 构建输出（APK、baseline profiles 等二进制）
/app/release/
