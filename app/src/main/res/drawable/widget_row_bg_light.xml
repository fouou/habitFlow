<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded pill background for a pending habit row (light theme). Solid concrete
     color (NOT ?android:attr) so the launcher host renders the intended shade. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F1F0F4" />
    <stroke
        android:width="1dp"
        android:color="#1F000000" />
    <corners android:radius="18dp" />
</shape>
